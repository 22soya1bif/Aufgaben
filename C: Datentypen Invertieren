/* Implementieren Sie die Funktion isLSB
*/

bool isLSB() {
    int value = 0x12345678;
    char *ptr = (char*)&value;
    return ptr[0] == 0x78 && ptr[1] == 0x56 && ptr[2] == 0x34 && ptr[3] == 0x12;
}

/* Implementieren Sie die Funktion isMSB
*/

bool isMSB() {
    int value = 0x12345678;
    char *ptr = (char*)&value;
    return ptr[0] == 0x12 && ptr[1] == 0x34 && ptr[2] == 0x56 && ptr[3] == 0x78;
}

void convertToRaw(const primitiveTypes *primitiveType, char data[], int size)

{
    if ( size>sizeof(primitiveTypes) ) {
        size = sizeof(primitiveTypes);
    }
    memcpy(data,primitiveType,size);
}

