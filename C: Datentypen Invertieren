/* Erklären Sie an dieser Stelle, wie sich die Größe einer Struktur vom Type overLoadUnpacked ergibt
* Antwort: Die Größe der Struktur ergibt sich durch den Tag (in diesem Fall short) + die größte Größe der Union (Double).
* Heißt 2 Bytes (short) + 8 Bytes (Double).
* Wenn eine Struktur "unpacked" ist, dann setzt das System Ausrichtungslücken für effizienten Zugriff ein,
* was heißt, die Größe wird mindestens 10 Bytes sein, aber idR größer aufgrund der Lücken.
*/

struct overLoadUnpacked {
    short tag;
    union {
        bool asBool;
        char asChar;
        short asShort;
        int asInt;
        long asLong;
        float asFloat;
        double asDouble;
        void *asVoidP;
        unsigned char asUChar;
        unsigned short asUShort;
        unsigned int asUInt;
        unsigned long asULong;
        char *asString;
    };
};
typedef struct overLoadUnpacked overLoadUnpacked;

/* Erklären Sie an dieser Stelle, wie sich die Größe einer Struktur vom Type overLoadPacked ergibt
* Antwort: Die Größe der Struktur ergibt sich durch den Tag (in diesem Fall short) + die größte Größe der Union (Double).
* Heißt 2 Bytes (short) + 8 Bytes (Double).
* Wenn eine Struktur "packed" ist, dann setzt das System keine Ausrichtungslücken für effizienten Zugriff ein,
* was heißt, die Größe wird wahrscheinlich genau bei 10 Bytes liegen.
*/

struct overLoadPacked {
    short tag;
    union {
        bool asBool;
        char asChar;
        short asShort;
        int asInt;
        long asLong;
        float asFloat;
        double asDouble;
        void *asVoidP;
        unsigned char asUChar;
        unsigned short asUShort;
        unsigned int asUInt;
        unsigned long asULong;
        char *asString;
    };
} __attribute__ ((packed));

typedef struct overLoadPacked overLoadPacked;

union primitiveTypes {
    bool asBool;
    char asChar;
    short asShort;
    int asInt;
    long asLong;
    float asFloat;
    double asDouble;
    void *asVoidP;
    unsigned char asUChar;
    unsigned short asUShort;
    unsigned int asUInt;
    unsigned long asULong;
    char asRawData[sizeof(double)]; // Assuming that double is the largest type
};
typedef union primitiveTypes primitiveTypes;

/* Implementieren Sie die Funktion printOneoverLoaded
*/

void printOneoverLoaded(overLoadUnpacked x)

{
    switch (x.tag) {
        case IS_BOOL:
            printf("Bool-Wert: %s\n", x.asBool ? "true" : "false");
            break;
        case IS_CHAR:
            printf("Char-Wert: %c\n", x.asChar);
            break;
        case IS_SHORT:
            printf("Short Integer Wert: %d\n", x.asShort);
            break;
        case IS_INT:
            printf("Integer Wert: %d\n", x.asInt);
            break;
        case IS_LONG:
            printf("Long Integer Wert: %ld\n", x.asLong);
            break;
        case IS_FLOAT:
            printf("Float Wert: %f\n", x.asFloat);
            break;
        case IS_DOUBLE:
            printf("Double Wert: %lf\n", x.asDouble);
            break;
        case IS_VOIDP:
            printf("Void Pointer Wert: %p\n", x.asVoidP);
            break;
        case IS_UCHAR:
            printf("Unsigned Character Wert: %c\n", x.asUChar);
            break;
        case IS_USHORT:
            printf("Unsigned Short Integer Wert: %u\n", x.asUShort);
            break;
        case IS_UINT:
            printf("Unsigned Integer Wert: %u\n", x.asUInt);
            break;
        case IS_ULONG:
            printf("Unsigned Long Integer Wert: %lu\n", x.asULong);
            break;
        case IS_STRING:
            printf("String Wert: %s\n", x.asString);
            break;
        default:
            printf("falsch\n");
    }
}

