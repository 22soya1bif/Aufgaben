/* Implementieren Sie die Funktion invertByteOrderShort
*/

short invertByteOrderShort(short data)

{
    short result = 0;
    size_t size = sizeof(short); // Change to sizeof(short)
    for (size_t i = 0; i < size; ++i) {
        result |= ((data >> (8 * i)) & 0xFF) << (8 * (size - 1 - i));
    }
    return result;
}

/* Implementieren Sie die Funktion invertByteOrderInt
